{
  "training": {
    "solver": "synreal",
    "recipe": "official_adapted_v1",
    "num_envs": 1024,
    "iterations": 10000,
    "seed": 42,
    "device": "cuda:0",
    "viewer": "null",
    "run_name": "synreal_official_adapted"
